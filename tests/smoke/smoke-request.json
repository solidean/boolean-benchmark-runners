{
  "kind": "boolean-benchmark",
  "version": 1,
  "id": "smoke-manual",
  "system_snapshot": {},
  "runs": [
    {
      "case_id": "smoke-cube-minus-cube",
      "out_dir": "smoke-output",
      "bounding_box": {
        "min": [0.0, 0.0, 0.0],
        "max": [1.1, 1.2, 1.3]
      },
      "operations": [
        {
          "op": "load-mesh",
          "path": "cube.obj",
          "name": "cube.obj"
        },
        {
          "op": "load-mesh",
          "path": "cube-translated.obj",
          "name": "cube-translated.obj"
        },
        {
          "op": "boolean-difference",
          "args": [0, 1]
        }
      ]
    }
  ]
}
